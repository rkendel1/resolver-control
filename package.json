{
  "name": "resolver-control",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Resolver Control: discover, govern, change and verify the runtime dependencies applications resolve through Resolver, without redeploying them.",
  "scripts": {
    "dev": "feltkit dev",
    "build": "feltkit build",
    "start": "feltkit start",
    "test": "feltkit test",
    "test:e2e": "node --test --test-concurrency=1 e2e/*.test.mjs",
    "inspect": "feltkit inspect",
    "typecheck": "tsc --noEmit",
    "build:app": "feltkit build --target appboundry",
    "discover": "node scripts/discover.mjs",
    "test:artifact": "feltkit build --target appboundry && node --import tsx --test artifact-tests/*.test.ts",
    "demo": "node scripts/demo.mjs",
    "measure": "feltkit measure",
    "measure:check": "feltkit measure --check",
    "signer": "node --import tsx signer/server.ts"
  },
  "dependencies": {
    "@appport/resolver-client": "file:vendor/appport-resolver-client-0.3.0.tgz",
    "@appport/resolver-core": "file:vendor/appport-resolver-core-0.2.0.tgz",
    "@feltdb/feltkit": "0.3.25",
    "@stack-ui/core": "^0.8.1",
    "@stack-ui/react": "^0.8.1",
    "@stack-ui/tokens": "^0.8.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "overrides": {
    "@appport/resolver-core": "file:vendor/appport-resolver-core-0.2.0.tgz"
  }
}
